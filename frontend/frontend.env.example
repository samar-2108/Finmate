# ─────────────────────────────────────────────────────────────
# FinMate Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to git.
#
#   cp .env.example .env
#
# All variables MUST be prefixed with VITE_ to be accessible
# inside the React app via import.meta.env.VITE_*
# ─────────────────────────────────────────────────────────────

# Backend API URL.
# During local development this is already the default in api.js,
# so you only need to set this for production deployments.
# Example: https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000
