# ─────────────────────────────────────────────────────────────
# FinMate Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to git.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
# Get your free Gemini API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────
# Get a free Alpha Vantage key at: https://www.alphavantage.co/support/#api-key
# Used for live gold price. Falls back gracefully if not set.
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Your deployed frontend URL (for CORS in production).
# Leave blank during local development — localhost:5173 is always allowed.
# Example: https://your-app.vercel.app
FRONTEND_URL=
